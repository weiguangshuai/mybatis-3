@startuml
title MyBatis 3 类调用时序图（启动阶段：解析配置并构建 SqlSessionFactory）
autonumber

actor "应用程序" as App
participant "SqlSessionFactoryBuilder" as SFB
participant "XMLConfigBuilder" as XCB
participant "Configuration" as CFG
participant "XMLMapperBuilder" as XMB
participant "MapperBuilderAssistant" as MBA
participant "DefaultSqlSessionFactory" as DSSF

App -> SFB: build(reader, environment, properties)
SFB -> XCB: new XMLConfigBuilder(reader, environment, properties)
SFB -> XCB: parse()
XCB -> XCB: parseConfiguration(/configuration)
XCB -> CFG: settingsElement()\npluginElement()\ntypeAliasesElement() ...
XCB -> XCB: environmentsElement()
XCB -> CFG: setEnvironment(Environment)

loop 遍历 <mappers> 中每个 mapper 资源
  XCB -> XMB: new XMLMapperBuilder(input, cfg, resource, sqlFragments)
  XCB -> XMB: parse()
  XMB -> MBA: setCurrentNamespace(namespace)
  XMB -> MBA: addResultMap(...)
  XMB -> MBA: addMappedStatement(...)
  MBA -> CFG: addResultMap()\naddMappedStatement()\naddCache() ...
end

XCB --> SFB: Configuration
SFB -> DSSF: new DefaultSqlSessionFactory(Configuration)
DSSF --> App: SqlSessionFactory
@enduml

@startuml
title MyBatis 3 类调用时序图（运行阶段：Mapper SELECT 详细链路）
autonumber

actor "业务调用方(Service/Controller)" as Caller
participant "SqlSessionFactory" as SF
participant "DefaultSqlSessionFactory" as DSF
participant "Configuration" as CFG
participant "TransactionFactory" as TF
participant "Transaction" as TX
participant "Executor(插件代理后)" as EX
participant "CachingExecutor" as CEX
participant "BaseExecutor(含Simple/Reuse/Batch实现)" as BEX
participant "DefaultSqlSession" as SS
participant "MapperRegistry" as MR
participant "MapperProxy(JDK动态代理)" as MP
participant "MapperMethod" as MM
participant "MappedStatement" as MS
participant "RoutingStatementHandler" as SH
participant "PreparedStatementHandler" as PSH
participant "DefaultParameterHandler" as PH
participant "DefaultResultSetHandler" as RH
participant "TypeHandler" as TH
participant "JDBC(Connection/PreparedStatement)" as JDBC
database "数据库" as DB

Caller -> SF: openSession()
SF -> DSF: openSessionFromDataSource(execType, level, autoCommit)
DSF -> CFG: getEnvironment()
DSF -> TF: newTransaction(dataSource, level, autoCommit)
TF --> DSF: Transaction
DSF -> CFG: newExecutor(tx, execType)
CFG -> BEX: new SimpleExecutor(cfg, tx)\n或 ReuseExecutor/BatchExecutor
opt cacheEnabled == true
  CFG -> CEX: new CachingExecutor(delegate)
end
CFG -> CFG: interceptorChain.pluginAll(executor)
CFG --> DSF: Executor(可能被插件包装)
DSF -> SS: new DefaultSqlSession(cfg, executor, autoCommit)
SS --> Caller: SqlSession

Caller -> SS: getMapper(UserMapper.class)
SS -> CFG: getMapper(type, sqlSession)
CFG -> MR: getMapper(type, sqlSession)
MR --> Caller: Mapper 接口代理对象(MapperProxy)

Caller -> MP: mapper.selectById(id)
MP -> MP: invoke(proxy, method, args)
MP -> MP: cachedMapperMethod(method)
alt 首次调用该 mapper 方法
  MP -> MM: new MapperMethod(mapperInterface, method, cfg)
end
MP -> MM: execute(sqlSession, args)
MM -> MM: convertArgsToSqlCommandParam(args)
MM -> SS: selectOne/selectList(statementId, param)
SS -> CFG: getMappedStatement(statementId)
CFG --> SS: MappedStatement
SS -> EX: query(ms, param, rowBounds, NO_RESULT_HANDLER)

EX -> CEX: query(...)
CEX -> MS: getBoundSql(parameterObject)
CEX -> CEX: createCacheKey(ms, param, rowBounds, boundSql)
alt 二级缓存命中(L2 hit)
  CEX --> EX: 返回缓存结果
else 二级缓存未命中或未启用
  CEX -> BEX: query(ms, param, rowBounds, resultHandler, cacheKey, boundSql)
  BEX -> BEX: 一级缓存(localCache)查询
  alt 一级缓存命中(L1 hit)
    BEX --> CEX: 返回缓存结果
  else 一级缓存未命中
    BEX -> BEX: doQuery(...)
    BEX -> CFG: newStatementHandler(wrapper, ms, param, rowBounds, resultHandler, boundSql)
    CFG -> SH: new RoutingStatementHandler(...)
    note right of SH
      根据 StatementType 路由:
      PREPARED / STATEMENT / CALLABLE
    end note
    SH -> PSH: 典型场景选择 PreparedStatementHandler

    PSH -> CFG: newParameterHandler(ms, param, boundSql)
    CFG -> PH: new DefaultParameterHandler(...)
    CFG -> CFG: interceptorChain.pluginAll(parameterHandler)

    PSH -> CFG: newResultSetHandler(executor, ms, rowBounds,\nparameterHandler, resultHandler, boundSql)
    CFG -> RH: new DefaultResultSetHandler(...)
    CFG -> CFG: interceptorChain.pluginAll(resultSetHandler)
    CFG -> CFG: interceptorChain.pluginAll(statementHandler)
    CFG --> BEX: StatementHandler(可能被插件包装)

    BEX -> TX: getConnection()
    TX --> BEX: Connection
    BEX -> SH: prepare(connection, transactionTimeout)
    SH -> PSH: instantiateStatement(connection)
    PSH --> SH: PreparedStatement

    BEX -> SH: parameterize(statement)
    SH -> PSH: parameterize(statement)
    PSH -> PH: setParameters(preparedStatement)
    PH -> TH: setParameter(ps, index, value, jdbcType)

    BEX -> SH: query(statement, resultHandler)
    SH -> PSH: query(statement, resultHandler)
    PSH -> JDBC: execute()
    JDBC -> DB: 执行 SQL
    DB --> JDBC: ResultSet

    PSH -> RH: handleResultSets(statement)
    RH --> PSH: List<MappedObject>
    PSH --> SH: List<MappedObject>
    SH --> BEX: List<MappedObject>
    BEX -> BEX: localCache.putObject(cacheKey, list)
    BEX --> CEX: List<MappedObject>
  end

  opt 开启二级缓存且允许写入
    CEX -> CEX: putObject(cache, cacheKey, list)
  end
  CEX --> EX: List<MappedObject>
end

EX --> SS: List<MappedObject>
SS --> MM: 返回查询结果
MM --> MP: 方法返回值
MP --> Caller: 最终结果
@enduml
