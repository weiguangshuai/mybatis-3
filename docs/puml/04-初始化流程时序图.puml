@startuml MyBatis-Initialization初始化流程
title MyBatis 初始化流程时序图
hide footbox

actor 开发者 as User
participant ":SqlSessionFactoryBuilder" as Builder
participant ":XMLConfigBuilder" as ConfigBuilder
participant ":Configuration" as Config
participant ":XMLMapperBuilder" as MapperBuilder
participant ":XMLStatementBuilder" as StatementBuilder
participant ":TransactionFactory" as TransFactory
participant ":DataSourceFactory" as DSFactory
participant ":Environment" as Environment
participant ":DefaultSqlSessionFactory" as SqlSessionFactory
participant ":Executor" as Executor
participant ":CachingExecutor" as CachingExec

== 1. 构建 Configuration ==

User -> Builder: build(reader/inputStream, environment, properties)
Builder -> ConfigBuilder: new XMLConfigBuilder(...)
Builder -> ConfigBuilder: parse()
activate ConfigBuilder

ConfigBuilder -> ConfigBuilder: parseConfiguration(/configuration)
ConfigBuilder -> ConfigBuilder: propertiesElement(...)
ConfigBuilder -> ConfigBuilder: settingsAsProperties(...)
ConfigBuilder -> ConfigBuilder: loadCustomVfs()/loadCustomLogImpl()
ConfigBuilder -> ConfigBuilder: typeAliasesElement(...)
ConfigBuilder -> ConfigBuilder: pluginElement(...)
ConfigBuilder -> ConfigBuilder: objectFactoryElement(...)
ConfigBuilder -> ConfigBuilder: objectWrapperFactoryElement(...)
ConfigBuilder -> ConfigBuilder: reflectorFactoryElement(...)
ConfigBuilder -> ConfigBuilder: settingsElement(settings)

ConfigBuilder -> ConfigBuilder: environmentsElement(...)
ConfigBuilder -> TransFactory: transactionManagerElement(...)
ConfigBuilder -> DSFactory: dataSourceElement(...)
ConfigBuilder -> Environment: new Environment.Builder(...).build()
ConfigBuilder -> Config: setEnvironment(environment)

ConfigBuilder -> ConfigBuilder: databaseIdProviderElement(...)
ConfigBuilder -> ConfigBuilder: typeHandlerElement(...)
ConfigBuilder -> ConfigBuilder: mapperElement(...)

alt mapper 使用 resource/url
  ConfigBuilder -> MapperBuilder: new XMLMapperBuilder(...)
  activate MapperBuilder
  MapperBuilder -> MapperBuilder: parse()
  MapperBuilder -> MapperBuilder: configurationElement(/mapper)
  MapperBuilder -> MapperBuilder: cacheRef/cache/resultMap/sql
  MapperBuilder -> StatementBuilder: parseStatementNode()
  StatementBuilder -> StatementBuilder: processSelectKeyNodes(...)
  StatementBuilder -> StatementBuilder: langDriver.createSqlSource(...)
  StatementBuilder -> Config: addMappedStatement(...)
  MapperBuilder -> MapperBuilder: bindMapperForNamespace()
  MapperBuilder --> ConfigBuilder: void
  deactivate MapperBuilder
else mapper 使用 class
  ConfigBuilder -> Config: addMapper(mapperInterface)
end

ConfigBuilder --> Builder: Configuration
deactivate ConfigBuilder
Builder -> SqlSessionFactory: new DefaultSqlSessionFactory(configuration)
Builder --> User: SqlSessionFactory

== 2. 打开 SqlSession ==

User -> SqlSessionFactory: openSession(execType, level, autoCommit)
activate SqlSessionFactory

SqlSessionFactory -> Config: getEnvironment()
Config --> SqlSessionFactory: Environment
SqlSessionFactory -> TransFactory: newTransaction(dataSource, level, autoCommit)
SqlSessionFactory -> Config: newExecutor(tx, execType)

alt ExecutorType.BATCH
  Config -> Executor: new BatchExecutor(configuration, tx)
else ExecutorType.REUSE
  Config -> Executor: new ReuseExecutor(configuration, tx)
else ExecutorType.SIMPLE
  Config -> Executor: new SimpleExecutor(configuration, tx)
end

alt cacheEnabled=true
  Config -> CachingExec: new CachingExecutor(executor)
  CachingExec --> Config: wrappedExecutor
end

Config --> SqlSessionFactory: Executor
SqlSessionFactory -> SqlSessionFactory: new DefaultSqlSession(configuration, executor, autoCommit)
SqlSessionFactory --> User: SqlSession
deactivate SqlSessionFactory

note over User
  主路径:
  build() -> XMLConfigBuilder.parse()
  -> Configuration 完成装配
  -> DefaultSqlSessionFactory.openSession()
  -> Configuration.newExecutor(...)
end note

@enduml