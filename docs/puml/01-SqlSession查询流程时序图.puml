@startuml MyBatis-SqlSession-Select流程
title MyBatis SqlSession 查询流程时序图
hide footbox

actor 用户 as User
participant ":DefaultSqlSession" as SqlSession
participant ":Configuration" as Config
participant ":CachingExecutor" as CachingExec
participant ":BaseExecutor" as BaseExec
participant ":SimpleExecutor" as SimpleExec
participant ":StatementHandler" as StatementHandler
participant ":ParameterHandler" as ParameterHandler
participant ":ResultSetHandler" as ResultSetHandler
participant ":Transaction" as Transaction
participant ":Connection" as Connection
participant ":PreparedStatement" as PS

== 1. 查询入口 ==

User -> SqlSession: selectOne(statementId, parameter)
note right of SqlSession
  selectOne() 内部先调用 selectList()
  再根据结果条数返回单条/抛异常/返回 null
end note

SqlSession -> SqlSession: selectList(statementId, parameter)
SqlSession -> Config: getMappedStatement(statementId)
Config --> SqlSession: MappedStatement
SqlSession -> CachingExec: query(ms, wrapCollection(parameter), rowBounds, handler)
activate CachingExec

== 2. 二级缓存处理 ==

CachingExec -> CachingExec: boundSql = ms.getBoundSql(parameter)
CachingExec -> CachingExec: key = createCacheKey(ms, parameter, rowBounds, boundSql)

alt 配置了二级缓存 && useCache=true && resultHandler==null
  CachingExec -> CachingExec: flushCacheIfRequired(ms)
  CachingExec -> CachingExec: ensureNoOutParams(ms, boundSql)
  CachingExec -> CachingExec: tcm.getObject(cache, key)

  alt 二级缓存命中
    CachingExec --> SqlSession: cachedList
    deactivate CachingExec
  else 二级缓存未命中
    CachingExec -> BaseExec: query(ms, parameter, rowBounds, handler, key, boundSql)
    activate BaseExec
  end
else 未配置二级缓存 or useCache=false or 自定义ResultHandler
  CachingExec -> BaseExec: query(ms, parameter, rowBounds, handler, key, boundSql)
  activate BaseExec
end

== 3. 一级缓存处理 ==

alt queryStack==0 && flushCacheRequired=true
  BaseExec -> BaseExec: clearLocalCache()
end

alt resultHandler==null 且 localCache 命中
  BaseExec -> BaseExec: localCache.getObject(key)
  BaseExec --> CachingExec: cachedList
else 一级缓存未命中
  BaseExec -> BaseExec: queryFromDatabase(...)
  note right of BaseExec
    queryFromDatabase() 会先放入
    EXECUTION_PLACEHOLDER，查询完成后
    再将结果写回 localCache
  end note

  BaseExec -> SimpleExec: doQuery(ms, parameter, rowBounds, resultHandler, boundSql)
  activate SimpleExec

  == 4. 创建 Statement 并执行 SQL ==

  SimpleExec -> Config: newStatementHandler(executor, ms, parameter, rowBounds, resultHandler, boundSql)
  Config --> SimpleExec: StatementHandler

  SimpleExec -> Transaction: getConnection()
  Transaction -> Connection: getConnection()
  Connection --> Transaction: Connection
  Transaction --> SimpleExec: Connection

  SimpleExec -> StatementHandler: prepare(connection, timeout)
  StatementHandler -> Connection: prepareStatement(sql)
  Connection --> StatementHandler: PreparedStatement

  SimpleExec -> StatementHandler: parameterize(statement)
  StatementHandler -> ParameterHandler: setParameters(ps)
  ParameterHandler -> PS: typeHandler.setParameter(i, value, jdbcType)

  == 5. 结果集映射 ==

  SimpleExec -> StatementHandler: query(statement, resultHandler)
  StatementHandler -> PS: execute()
  PS --> StatementHandler: executed
  StatementHandler -> ResultSetHandler: handleResultSets(ps)
  activate ResultSetHandler
  ResultSetHandler -> PS: getResultSet()/getMoreResults()
  ResultSetHandler -> ResultSetHandler: handleRowValues(...)
  ResultSetHandler -> ResultSetHandler: createResultObject(...)
  ResultSetHandler -> ResultSetHandler: applyAutomaticMappings(...)
  ResultSetHandler -> ResultSetHandler: applyPropertyMappings(...)
  ResultSetHandler --> StatementHandler: List<ResultObject>
  deactivate ResultSetHandler

  StatementHandler --> SimpleExec: List<ResultObject>
  SimpleExec --> BaseExec: List<ResultObject>
  deactivate SimpleExec

  BaseExec -> BaseExec: localCache.putObject(key, list)
  note right of BaseExec
    CacheKey 包含:
    ms.id / offset / limit / SQL / 参数值 / environmentId
  end note
  BaseExec --> CachingExec: List<ResultObject>
end

deactivate BaseExec

== 6. 返回结果 ==

alt 二级缓存可用且本次为数据库查询结果
  CachingExec -> CachingExec: tcm.putObject(cache, key, list)
  note right of CachingExec
    这里只写入 TransactionalCache
    真正刷入二级缓存发生在 commit()
  end note
end

CachingExec --> SqlSession: List<ResultObject>
deactivate CachingExec
SqlSession --> User: ResultObject / List<ResultObject>

@enduml