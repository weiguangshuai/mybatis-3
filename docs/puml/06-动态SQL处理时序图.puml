@startuml MyBatis-Dynamic-SQL动态SQL处理
title MyBatis 动态SQL处理时序图
hide footbox

actor 开发者 as User
participant ":XMLScriptBuilder" as ScriptBuilder
participant ":MixedSqlNode" as MixedSqlNode
participant ":IfSqlNode" as IfSqlNode
participant ":ForEachSqlNode" as ForEachSqlNode
participant ":TrimSqlNode" as TrimSqlNode
participant ":TextSqlNode" as TextSqlNode
participant ":StaticTextSqlNode" as StaticTextSqlNode
participant ":DynamicSqlSource" as DynamicSqlSource
participant ":RawSqlSource" as RawSqlSource
participant ":DynamicContext" as DynamicContext
participant ":OgnlCache / ExpressionEvaluator" as OgnlEvaluator
participant ":SqlSourceBuilder" as SqlSourceBuilder
participant ":BoundSql" as BoundSql
participant ":DefaultParameterHandler" as ParameterHandler
participant ":PreparedStatement" as PS

== 1. 初始化阶段：构建 SqlSource ==

User -> ScriptBuilder: parseScriptNode()
activate ScriptBuilder
ScriptBuilder -> ScriptBuilder: parseDynamicTags(context)

loop 遍历 SQL 节点
  alt 文本节点且包含 ${}
    ScriptBuilder -> TextSqlNode: new TextSqlNode(text)
    TextSqlNode -> TextSqlNode: isDynamic()
  else 纯文本节点
    ScriptBuilder -> StaticTextSqlNode: new StaticTextSqlNode(text)
  else if / when
    ScriptBuilder -> IfSqlNode: new IfSqlNode(contents, test)
  else foreach
    ScriptBuilder -> ForEachSqlNode: new ForEachSqlNode(configuration, contents, collection, nullable, index, item, open, close, separator)
  else where / set / trim
    ScriptBuilder -> TrimSqlNode: new WhereSqlNode / SetSqlNode / TrimSqlNode(...)
  end
end

ScriptBuilder -> MixedSqlNode: new MixedSqlNode(contents)

alt isDynamic == true
  ScriptBuilder -> DynamicSqlSource: new DynamicSqlSource(configuration, rootSqlNode)
  ScriptBuilder --> User: DynamicSqlSource
else isDynamic == false
  ScriptBuilder -> RawSqlSource: new RawSqlSource(configuration, rootSqlNode, parameterType)
  ScriptBuilder --> User: RawSqlSource
end

deactivate ScriptBuilder

== 2. 运行时：DynamicSqlSource.getBoundSql() ==

User -> DynamicSqlSource: getBoundSql(parameterObject)
activate DynamicSqlSource
DynamicSqlSource -> DynamicContext: new DynamicContext(configuration, parameterObject)
DynamicSqlSource -> MixedSqlNode: apply(context)
activate MixedSqlNode

loop 遍历运行时 SqlNode
  alt IfSqlNode
    MixedSqlNode -> IfSqlNode: apply(context)
    IfSqlNode -> OgnlEvaluator: evaluateBoolean(test, context.bindings)
    alt 条件成立
      IfSqlNode -> DynamicContext: appendSql(child sql)
    end
  else ForEachSqlNode
    MixedSqlNode -> ForEachSqlNode: apply(context)
    ForEachSqlNode -> OgnlEvaluator: evaluateIterable(collectionExpression, bindings, nullable)
    ForEachSqlNode -> DynamicContext: appendSql(open)
    note right of ForEachSqlNode
      foreach 会为 item/index 绑定变量，
      并生成带唯一编号的参数名
    end note
    ForEachSqlNode -> DynamicContext: appendSql(item sql + separator + close)
  else Where / Set / Trim
    MixedSqlNode -> TrimSqlNode: apply(filteredContext)
    note right of TrimSqlNode
      WhereSqlNode / SetSqlNode
      都是 TrimSqlNode 的特化实现
    end note
  else TextSqlNode
    MixedSqlNode -> TextSqlNode: apply(context)
    TextSqlNode -> OgnlEvaluator: getValue(${expr}, bindings)
    TextSqlNode -> DynamicContext: appendSql(text / resolvedValue)
  else StaticTextSqlNode
    MixedSqlNode -> StaticTextSqlNode: apply(context)
    StaticTextSqlNode -> DynamicContext: appendSql(text)
  end
end

deactivate MixedSqlNode
DynamicSqlSource -> DynamicContext: getSql()
DynamicSqlSource -> DynamicContext: getBindings()
DynamicSqlSource -> SqlSourceBuilder: parse(sql, parameterType, bindings)
SqlSourceBuilder --> DynamicSqlSource: SqlSource
DynamicSqlSource -> BoundSql: sqlSource.getBoundSql(parameterObject)
DynamicSqlSource -> BoundSql: setAdditionalParameter(binding)
DynamicSqlSource --> User: BoundSql
deactivate DynamicSqlSource

== 3. 参数绑定阶段 ==

User -> ParameterHandler: setParameters(ps)
activate ParameterHandler
ParameterHandler -> BoundSql: getParameterMappings()
loop 遍历 ParameterMapping
  ParameterHandler -> ParameterHandler: 从 additionalParameters / parameterObject 取值
  ParameterHandler -> PS: typeHandler.setParameter(i, value, jdbcType)
end
ParameterHandler --> User: void
deactivate ParameterHandler

note over User
  关键点:
  1. ${} 在 TextSqlNode.apply() 阶段直接拼接 SQL
  2. #{} 在 SqlSourceBuilder.parse() 后变成 ParameterMappings
  3. BoundSql 保存最终 SQL 与 additionalParameters
end note

@enduml