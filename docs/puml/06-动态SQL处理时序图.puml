@startuml MyBatis-Dynamic-SQL动态SQL处理
title MyBatis 动态SQL处理时序图
hide footbox

participant ":SqlSource" as SqlSource
participant ":MixedSqlNode" as MixedSqlNode
participant ":SqlNode" as SqlNode
participant ":DynamicContext" as DynamicContext
participant ":BindingContext" as BindingContext
participant ":ExpressionEvaluator" as Evaluator
participant ":OgnlCache" as OgnlCache
participant ":IfSqlNode" as IfSqlNode
participant ":ForeachSqlNode" as ForeachSqlNode
participant ":WhereSqlNode" as WhereSqlNode
participant ":SetSqlNode" as SetSqlNode
participant ":TrimSqlNode" as TrimSqlNode
participant ":TextSqlNode" as TextSqlNode
participant ":BoundSql" as BoundSql
participant ":ParameterHandler" as ParameterHandler
participant ":ResultSetHandler" as ResultSetHandler
participant ":PreparedStatement" as PS

note over SqlSource
  ★ 解析时机:
  MyBatis初始化阶段
  XMLMapperBuilder.parseStatementNodes()
end note

== 1. 动态SQL解析阶段（初始化时）==

SqlSourceBuilder -> SqlSourceBuilder: parse(dynamicContext, parameterType, lang)
note right of SqlSourceBuilder
  解析XML中的SQL片段
  构建SqlSource对象
end note

alt 动态SQL（包含${}或动态标签）
    SqlSourceBuilder -> MixedSqlNode: new MixedSqlNode(contents)
    note right of MixedSqlNode
      创建MixedSqlNode
      包含所有SQL节点
    end note
    activate MixedSqlNode

    loop for each content (SqlNode)
        alt if标签
            SqlSourceBuilder -> IfSqlNode: new IfSqlNode(mixedSqlNode, test)
        else foreach标签
            SqlSourceBuilder -> ForeachSqlNode: new ForeachSqlNode(mixedSqlNode, collection, item, ...)
        else where标签
            SqlSourceBuilder -> WhereSqlNode: new WhereSqlNode(mixedSqlNode)
        else set标签
            SqlSourceBuilder -> SetSqlNode: new SetSqlNode(mixedSqlNode)
        else trim标签
            SqlSourceBuilder -> TrimSqlNode: new TrimSqlNode(mixedSqlNode, prefix, prefixOverrides, ...)
        else 文本节点
            SqlSourceBuilder -> TextSqlNode: new TextSqlNode(sqlText)
        end
    end

    SqlSourceBuilder -> SqlSource: DynamicSqlSource
    note right of SqlSource
      创建动态SQL源
      运行时解析
    end note
    SqlSourceBuilder --> SqlSource: DynamicSqlSource

else 静态SQL（无${}和动态标签）
    SqlSourceBuilder -> SqlSource: RawSqlSource
    note right of SqlSource
      创建静态SQL源
      直接使用无需解析
    end note
    SqlSourceBuilder --> SqlSource: RawSqlSource
end

== 2. 动态SQL执行阶段（运行时）==

note over SqlSource
  ★ 执行时机:
  每次执行SQL时
  CachingExecutor.query() -> MappedStatement.getBoundSql()
end note

SqlSource -> SqlSource: getBoundSql(parameterObject)
note right of SqlSource
  获取绑定的SQL
  将动态SQL解析为可执行SQL
end note
activate SqlSource

SqlSource -> DynamicContext: new DynamicContext(configuration, parameterObject)
note right of DynamicContext
  创建动态上下文
  传入参数对象
end note
activate DynamicContext

DynamicContext -> BindingContext: new BindingContext(configuration, paramObject)
note right of BindingContext
  包装参数对象
  用于OGNL表达式求值
end note

SqlSource -> MixedSqlNode: applyAll(dynamicContext)
note right of MixedSqlNode
  应用所有SQL节点
  构建最终SQL
end note
activate MixedSqlNode

loop for each SqlNode in contents
    MixedSqlNode -> SqlNode: apply(context)
    note right of SqlNode
      执行每个SqlNode
      生成对应的SQL片段
    end note

    alt IfSqlNode - if条件判断
        SqlNode -> Evaluator: evaluateBoolean(test, parameterObject)
        Evaluator -> OgnlCache: parseExpression(test)
        OgnlCache --> Evaluator: expression
        Evaluator --> SqlNode: true/false

        alt 条件为true
            SqlNode -> SqlNode: apply child nodes
            note right of SqlNode
              条件成立
              SQL片段生效
            end note
        end
    end

    alt ForeachSqlNode - foreach循环
        SqlNode -> SqlNode: apply(context)
        SqlNode -> Evaluator: evaluateIterable(collection)
        note right of SqlNode
          获取集合迭代器
          支持List、Array、Map等
        end note

        loop for each item
            SqlNode -> DynamicContext: appendSql(item)
        end
    end

    alt WhereSqlNode - where条件处理
        SqlNode -> SqlNode: apply(context)
        SqlNode -> SqlNode: trimLeftWhitespace()
    end

    alt SetSqlNode - set处理
        SqlNode -> SqlNode: apply(context)
        SqlNode -> SqlNode: trimRightComma()
    end

    alt TrimSqlNode - 自定义trim
        SqlNode -> SqlNode: apply(context)
        SqlNode -> SqlNode: trim(prefix, prefixOverrides, suffix, suffixOverrides)
    end

    alt TextSqlNode - 文本处理
        SqlNode -> SqlNode: apply(context)

        alt 包含${}变量
            SqlNode -> OgnlCache: evaluateExpression(text)
            OgnlCache --> SqlNode: resolvedValue
            SqlNode -> DynamicContext: appendSql(resolvedValue)
        else 纯文本
            SqlNode -> DynamicContext: appendSql(text)
        end
    end
end

MixedSqlNode --> SqlSource: void
deactivate MixedSqlNode

SqlSource -> DynamicContext: getSql()
note right of DynamicContext
  获取最终SQL字符串
  (包含?占位符)
end note
DynamicContext --> SqlSource: sql
deactivate DynamicContext

SqlSource -> DynamicContext: getBindings()
DynamicContext --> SqlSource: parameterMappings

SqlSource -> BoundSql: new BoundSql(...)
note right of BoundSql
  创建BoundSql对象
  存储最终SQL和参数映射
end note
activate BoundSql
SqlSource --> BoundSql: BoundSql
deactivate SqlSource

== 3. 参数处理阶段（执行时）==

note over BoundSql
  ★ 参数绑定时机:
  StatementHandler.prepare()之后
  StatementHandler.parameterize()时
end note

ParameterHandler -> ParameterHandler: setParameters(PreparedStatement)
note right of ParameterHandler
  设置预编译语句参数
end note
activate ParameterHandler

ParameterHandler -> BoundSql: getParameterMappings()
BoundSql --> ParameterHandler: List<ParameterMapping>

loop for each parameterMapping
    ParameterHandler -> ParameterHandler: getParameterValue()
    ParameterHandler -> ParameterMapping: getTypeHandler()
    ParameterHandler -> ParameterHandler: setNonNullParameter()
    ParameterHandler -> PS: setXXX(i, value)
end

ParameterHandler --> PS: void
deactivate ParameterHandler

== 4. 结果处理阶段（返回时）==

note over PS
  ★ 结果映射时机:
  Statement执行完成后
  ResultSetHandler.handleResultSets()
end note

ResultSetHandler -> ResultSetHandler: handleResultSets(PreparedStatement)
note right of ResultSetHandler
  处理结果集
  将ResultSet映射为Java对象
end note
activate ResultSetHandler

ResultSetHandler -> ResultSetHandler: getFirstResultSet()

loop for each ResultSet
    ResultSetHandler -> ResultSetHandler: getResultSetMappings()

    loop for each resultMapping
        alt 简单属性映射
            ResultSetHandler -> ResultSetHandler: getPropertyMappingValue()
        else 嵌套查询映射
            ResultSetHandler -> ResultSetHandler: getNestedQueryMappingValue()
            ResultSetHandler -> ResultSetHandler: query nested statement
        else 嵌套结果映射
            ResultSetHandler -> ResultSetHandler: getNestedResultMappingValue()
        end
    end
end

ResultSetHandler -> ResultSetHandler: create result object
ResultSetHandler -> ResultSetHandler: applyAutomaticMappings()
ResultSetHandler -> ResultSetHandler: applyPropertyMappings()

ResultSetHandler --> ResultSetHandler: List<ResultObject>
deactivate ResultSetHandler

note over User
  MyBatis动态SQL标签:
  1. <if test="...">: 条件判断
  2. <choose>: 分支选择 (when/otherwise)
  3. <where>: 智能WHERE
  4. <set>: 智能SET
  5. <foreach>: 循环遍历
  6. <trim>: 自定义trim
  7. <bind>: OGNL变量绑定
  8. <include>: SQL片段引用
  9. ${}: 字符串替换 (有SQL注入风险)
  10. #{}: 参数占位符 (预编译,防注入)
end note

@enduml
