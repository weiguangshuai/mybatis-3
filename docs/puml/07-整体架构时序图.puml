@startuml MyBatis-Architecture-Overview
title MyBatis 整体架构时序图（模块协作）
hide footbox

actor 开发者 as User

box "客户端层" #LightBlue
  participant ":User Code" as UserCode
end box

box "核心 API 层" #LightYellow
  participant ":DefaultSqlSession" as SqlSession
  participant ":Configuration" as Config
  participant ":MapperRegistry" as MapperRegistry
  participant ":MapperProxyFactory" as MapperProxyFactory
  participant ":MapperProxy" as MapperProxy
  participant ":MapperMethod" as MapperMethod
  participant ":JDK Proxy" as JdkProxy
end box

box "执行器层" #LightGreen
  participant ":CachingExecutor" as CachingExec
  participant ":BaseExecutor" as BaseExec
  participant ":SimpleExecutor" as SimpleExec
end box

box "语句处理层" #LightCoral
  participant ":StatementHandler" as StatementHandler
  participant ":ParameterHandler" as ParamHandler
  participant ":ResultSetHandler" as ResultSetHandler
end box

box "基础设施层" #LightGray
  participant ":Transaction" as Transaction
  participant ":TransactionalCacheManager" as TCM
end box

== 1. 获取 Mapper 代理 ==

User -> SqlSession: getMapper(UserMapper.class)
SqlSession -> Config: getMapper(type, this)
Config -> MapperRegistry: getMapper(type, sqlSession)
MapperRegistry -> MapperProxyFactory: newInstance(sqlSession)
MapperProxyFactory -> MapperProxy: new MapperProxy(sqlSession, mapperInterface, methodCache)
MapperProxyFactory -> JdkProxy: Proxy.newProxyInstance(...)
JdkProxy --> MapperRegistry: mapperProxyInstance
MapperRegistry --> Config: mapperProxyInstance
Config --> SqlSession: mapperProxyInstance
SqlSession --> User: mapperProxyInstance

== 2. 执行查询 ==

UserCode -> JdkProxy: userMapper.selectUserById(1)
JdkProxy -> MapperProxy: invoke(proxy, method, args)
activate MapperProxy
MapperProxy -> MapperMethod: execute(sqlSession, args)
activate MapperMethod
MapperMethod -> SqlSession: selectOne(statement, param)
SqlSession -> Config: getMappedStatement(statementId)
Config --> SqlSession: MappedStatement
SqlSession -> CachingExec: query(ms, param, rowBounds, handler)
activate CachingExec

alt 二级缓存命中
  CachingExec -> TCM: getObject(cache, key)
  TCM --> CachingExec: cachedList
else 进入数据库查询链路
  CachingExec -> BaseExec: query(ms, param, rowBounds, handler, key, boundSql)
  activate BaseExec

  alt 一级缓存未命中
    BaseExec -> SimpleExec: doQuery(ms, param, rowBounds, resultHandler, boundSql)
    activate SimpleExec
    SimpleExec -> StatementHandler: prepare(connection, timeout)
    SimpleExec -> StatementHandler: parameterize(statement)
    StatementHandler -> ParamHandler: setParameters(ps)
    SimpleExec -> StatementHandler: query(statement, resultHandler)
    StatementHandler -> ResultSetHandler: handleResultSets(ps)
    ResultSetHandler --> StatementHandler: resultList
    StatementHandler --> SimpleExec: resultList
    SimpleExec --> BaseExec: resultList
    deactivate SimpleExec
  end

  BaseExec --> CachingExec: resultList
  deactivate BaseExec
end

CachingExec --> SqlSession: result
deactivate CachingExec
SqlSession --> MapperMethod: result
MapperMethod --> MapperProxy: returnValue
deactivate MapperMethod
MapperProxy --> JdkProxy: returnValue
deactivate MapperProxy
JdkProxy --> UserCode: returnValue

== 3. 执行更新 ==

UserCode -> JdkProxy: userMapper.updateUser(user)
JdkProxy -> MapperProxy: invoke(proxy, method, args)
activate MapperProxy
MapperProxy -> MapperMethod: execute(sqlSession, args)
activate MapperMethod
MapperMethod -> SqlSession: update(statement, param)
SqlSession -> CachingExec: update(ms, param)
activate CachingExec
CachingExec -> CachingExec: flushCacheIfRequired(ms)
CachingExec -> BaseExec: update(ms, param)
activate BaseExec
BaseExec -> BaseExec: clearLocalCache()
BaseExec -> SimpleExec: doUpdate(ms, param)
activate SimpleExec
SimpleExec -> StatementHandler: update(statement)
StatementHandler --> SimpleExec: rows
SimpleExec --> BaseExec: rows
deactivate SimpleExec
BaseExec --> CachingExec: rows
deactivate BaseExec
CachingExec --> SqlSession: rows
deactivate CachingExec
SqlSession --> MapperMethod: rows
MapperMethod --> MapperProxy: returnValue
deactivate MapperMethod
MapperProxy --> JdkProxy: returnValue
deactivate MapperProxy
JdkProxy --> UserCode: returnValue

== 4. 提交事务 ==

UserCode -> SqlSession: commit()
SqlSession -> CachingExec: commit(required)
activate CachingExec
CachingExec -> BaseExec: commit(required)
activate BaseExec
BaseExec -> Transaction: commit()
BaseExec --> CachingExec: void
deactivate BaseExec
CachingExec -> TCM: commit()
TCM --> CachingExec: cache flushed
CachingExec --> SqlSession: void
deactivate CachingExec

note over UserCode, TCM
  协作主路径:
  User Code -> SqlSession -> Mapper Proxy -> MapperMethod
  -> Executor -> StatementHandler -> ResultSetHandler
  更新后通过 commit() 将 TransactionalCache 同步到二级缓存
end note

@enduml