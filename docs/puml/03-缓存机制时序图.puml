@startuml MyBatis-Cache-缓存机制
title MyBatis 缓存机制时序图
hide footbox

actor 用户 as User
participant ":DefaultSqlSession" as SqlSession
participant ":CachingExecutor" as CachingExec
participant ":TransactionalCacheManager" as TCM
participant ":TransactionalCache" as TC
participant ":BaseExecutor" as BaseExec
participant ":PerpetualCache(LocalCache)" as LocalCache
participant ":Transaction" as Transaction

== 1. 一级缓存（SqlSession 级别） ==

note over BaseExec, LocalCache
  一级缓存位于 BaseExecutor.localCache
  生命周期默认与 SqlSession 一致
  localCacheScope=STATEMENT 时会在语句结束后清空
end note

User -> SqlSession: selectList(statement, parameter)
SqlSession -> CachingExec: query(ms, parameter, rowBounds, handler)
CachingExec -> BaseExec: query(ms, parameter, rowBounds, handler, key, boundSql)
activate BaseExec

alt queryStack==0 && flushCacheRequired=true
  BaseExec -> BaseExec: clearLocalCache()
end

alt resultHandler==null 且一级缓存命中
  BaseExec -> LocalCache: getObject(key)
  LocalCache --> BaseExec: cachedList
  BaseExec --> CachingExec: cachedList
else 一级缓存未命中 / 使用自定义ResultHandler
  BaseExec -> LocalCache: getObject(key)
  LocalCache --> BaseExec: null
  BaseExec -> LocalCache: putObject(key, EXECUTION_PLACEHOLDER)
  BaseExec -> BaseExec: doQuery(...)
  BaseExec -> LocalCache: putObject(key, freshList)
  note right of BaseExec
    CacheKey 由以下内容组成:
    statementId / offset / limit / SQL / 参数值 / environmentId
  end note
  BaseExec --> CachingExec: freshList
end

alt localCacheScope == STATEMENT
  BaseExec -> BaseExec: clearLocalCache()
end

deactivate BaseExec
CachingExec --> SqlSession: results
SqlSession --> User: results

== 2. 二级缓存（Mapper Namespace 级别） ==

note over CachingExec, TCM
  二级缓存的命中前提:
  1. MappedStatement 配置了 cache
  2. useCache = true
  3. resultHandler == null
end note

User -> SqlSession: selectList(namespace.statement, parameter)
SqlSession -> CachingExec: query(ms, parameter, rowBounds, handler)
activate CachingExec
CachingExec -> CachingExec: flushCacheIfRequired(ms)

alt cache != null && useCache=true && resultHandler==null
  CachingExec -> TCM: getObject(cache, key)
  TCM -> TC: getObject(key)
  TC --> TCM: cachedList / null

  alt 二级缓存命中
    TCM --> CachingExec: cachedList
    CachingExec --> SqlSession: cachedList
  else 二级缓存未命中
    TCM --> CachingExec: null
    CachingExec -> BaseExec: query(ms, parameter, rowBounds, handler, key, boundSql)
    activate BaseExec
    BaseExec --> CachingExec: freshList
    deactivate BaseExec
    CachingExec -> TCM: putObject(cache, key, freshList)
    note right of TCM
      这里只放入 TransactionalCache
      提交事务时才真正写入底层缓存
    end note
    TCM -> TC: putObject(key, freshList)
    TC --> TCM: pending write
    CachingExec --> SqlSession: freshList
  end
else 未配置二级缓存 / useCache=false / 自定义ResultHandler
  CachingExec -> BaseExec: query(ms, parameter, rowBounds, handler, key, boundSql)
  activate BaseExec
  BaseExec --> CachingExec: results
  deactivate BaseExec
  CachingExec --> SqlSession: results
end

deactivate CachingExec
SqlSession --> User: results

== 3. 更新语句与缓存清理 ==

User -> SqlSession: update(statement, parameter)
SqlSession -> CachingExec: update(ms, parameter)
activate CachingExec
CachingExec -> CachingExec: flushCacheIfRequired(ms)

alt cache != null && flushCacheRequired=true
  CachingExec -> TCM: clear(cache)
  TCM -> TC: clear()
  note right of TC
    clear() 先标记 clearOnCommit
    真正清底层缓存发生在 commit()
  end note
end

CachingExec -> BaseExec: update(ms, parameter)
activate BaseExec
BaseExec -> BaseExec: clearLocalCache()
BaseExec -> BaseExec: doUpdate(ms, parameter)
BaseExec --> CachingExec: rows
deactivate BaseExec
CachingExec --> SqlSession: rows
deactivate CachingExec
SqlSession --> User: rows

== 4. 事务提交与二级缓存同步 ==

User -> SqlSession: commit()
SqlSession -> CachingExec: commit(required)
activate CachingExec
CachingExec -> BaseExec: commit(required)
activate BaseExec
BaseExec -> BaseExec: clearLocalCache()
BaseExec -> BaseExec: flushStatements()
alt required=true
  BaseExec -> Transaction: commit()
end
BaseExec --> CachingExec: void
deactivate BaseExec

CachingExec -> TCM: commit()
TCM -> TC: commit()
note right of TC
  commit() 会:
  1. clearOnCommit 时先 clear delegate
  2. 刷新待写入 entriesToAddOnCommit
end note

CachingExec --> SqlSession: void
deactivate CachingExec
SqlSession --> User: commit complete

@enduml